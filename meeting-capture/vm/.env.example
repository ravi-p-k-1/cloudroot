# Copy to .env (next to this file, on the VM only) and fill in after
# setup.sh's first run. Never committed - .gitignore excludes any .env.

# Printed by setup.sh on first boot of the stack (or: docker logs vexa-lite
# | grep -i 'admin token'). Needed to mint the Vexa API key below and for
# any future admin-api calls.
ADMIN_TOKEN=

# Minted by setup.sh via `make provision-token`. This is what later phases'
# pipeline/ scripts use (X-API-Key) to send the bot and read transcripts -
# save the same value as the VEXA_API_KEY secret in cloudroot's GitHub
# Actions config when phase 4 wires that up.
VEXA_API_KEY=
