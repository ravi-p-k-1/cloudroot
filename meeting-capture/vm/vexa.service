# systemd unit template for Vexa Lite. Not used directly - install-service.sh
# fills in __VEXA_DIR__ / __VEXA_USER__ / __WHISPER_MODEL__ (setup.sh's own
# defaults, or whatever you ran it with) and copies the result to
# /etc/systemd/system/vexa.service. Re-run install-service.sh after changing
# WHISPER_MODEL or moving VEXA_DIR.
#
# Type=oneshot + RemainAfterExit=yes because "starting Vexa" here means
# running `make ... up`, which itself starts long-lived docker containers -
# there's no single foreground process for systemd to supervise directly.
[Unit]
Description=Vexa Lite meeting-capture bot (local Whisper STT)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=__VEXA_USER__
WorkingDirectory=__VEXA_DIR__
ExecStart=/usr/bin/make -C __VEXA_DIR__/deploy/lite up LOCAL_STT=1 WHISPER_MODEL=__WHISPER_MODEL__
ExecStop=/usr/bin/make -C __VEXA_DIR__ lite-down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
